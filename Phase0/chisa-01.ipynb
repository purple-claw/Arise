    "import numpy as np\n",
    "import math\n",
    "\n",
    "purple = np.array([128, 0, 128])\n",
    "purple = purple * 2\n",
    "sm = 0\n",
    "for i in purple:\n",
    "    sm += (i * i)\n",
    "sm = math.sqrt(sm)\n",
    "print(sm)\n",
    "print(np.linalg.norm(purple))"
   ]
